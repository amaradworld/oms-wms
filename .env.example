# ─── Backend (Render / .env.production) ───
DATABASE_URL=postgresql://user:password@host:5432/db
JWT_SECRET=generate-a-long-random-string
MFA_JWT_SECRET=generate-another-long-random-string
RESET_TOKEN_SECRET=generate-another-long-random-string
PORT=5000
NODE_ENV=production
CRON_SECRET=random-string-for-cron-endpoints
API_KEY=your-api-key-for-internal-requests

# CORS
CORS_ALLOWED_ORIGINS=https://globalsupply.in,https://app.globalsupply.in

# Platform
PLATFORM_OWNER_EMAIL=owner@globalsupply.in

# SMTP (required for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=GlobalSupply Techno
SMTP_FROM=noreply@globalsupply.in

# Marketplace Webhook Secrets (HMAC-SHA256)
FLIPKART_WEBHOOK_SECRET=your-flipkart-webhook-secret
NYKAA_WEBHOOK_SECRET=your-nykaa-webhook-secret
MYNTRA_WEBHOOK_SECRET=your-myntra-webhook-secret
TATACLIQ_WEBHOOK_SECRET=your-tatacliq-webhook-secret
AMAZON_WEBHOOK_SECRET=your-amazon-webhook-secret
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# Backup (S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
BACKUP_S3_BUCKET=globalsupply-backups
BACKUP_RESTORE_TOKEN=your-restore-secret-token
BACKUP_KEEP_COUNT=14

# Cron disabling (set to 'true' to disable)
# SLA_CRON_DISABLED=true
# REPORT_CRON_DISABLED=true

# ─── Frontend (Vercel env vars) ───
REACT_APP_API_URL=https://oms-wms.onrender.com/api
REACT_APP_SHOW_PLATFORM_LOGIN=true
