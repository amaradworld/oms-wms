# ─── Backend (Render / .env.production) ───
DATABASE_URL=postgresql://user:password@host:5432/db
JWT_SECRET=generate-a-long-random-string
PORT=5000
FRONTEND_URL=https://app.globalsupply.in
NODE_ENV=production
CRON_SECRET=random-string-for-cron-endpoints

# SMTP (required for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=SupplyHub
SMTP_FROM=noreply@supplyhub.com

# ─── Frontend (Vercel env vars) ───
REACT_APP_API_URL=https://oms-wms.onrender.com/api
