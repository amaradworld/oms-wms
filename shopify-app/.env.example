# Shopify App Credentials (from Shopify Partners dashboard)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_inventory,write_inventory

# Session / Auth
SESSION_SECRET=generate_a_random_string_here

# Backend API (your existing OMS/WMS backend)
OMS_API_URL=https://api.globalsupply.in
OMS_API_KEY=your_oms_api_key

# Database (for storing shop tokens)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (optional, for session store)
REDIS_URL=redis://localhost:6379

# Marketplace Credentials
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
NYKAA_API_KEY=
MYNTRA_API_KEY=
MYNTRA_SECRET=
TATACLIQ_API_KEY=
TATACLIQ_SELLER_ID=
