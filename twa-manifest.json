{
  "packageId": "in.globalsupply.techno",
  "host": "app.globalsupply.in",
  "name": "GlobalSupply Techno",
  "shortName": "GlobalSupply",
  "launchUrl": "/app",
  "scope": "/app",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#0F172A",
  "backgroundColor": "#0F172A",
  "enableNotifications": true,
  "enableSiteSettingsShortcut": true,
  "enableLocation": false,
  "enableCamera": true,
  "enableMicrophone": false,
  "enableBluetooth": true,
  "enablenfc": true,
  "fallbackType": "customtabs",
  "splashScreenFadeOutDuration": 300,
  "splashScreenImage": "android-launch-icon-512.png",
  "monochromeIcon": "android-monochrome-icon-512.png",
  "splashColor": "#0F172A",
  "startColor": "#0F172A",
  "endColor": "#0F172A",
  "webManifestUrl": "/manifest.json",
  "shareTarget": {
    "action": "/app/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "appVersion": "1.0.0",
  "appVersionCode": 1,
  "signingKey": {
    "path": "android.keystore",
    "alias": "android"
  },
  "minSdkVersion": 24,
  "targetSdkVersion": 34,
  "metafiles": false,
  "additionalTrustedOrigins": [],
  "launchHandler": {
    "clientMode": "auto",
    "navigateExistingClient": "always"
  },
  "pullNotification": {
    "delayed": true,
    "minInterval": 60
  }
}
