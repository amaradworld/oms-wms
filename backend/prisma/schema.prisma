generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  email         String   @unique
  passwordHash  String
  fullName      String?
  role          String   // SUPER_ADMIN, WAREHOUSE_MGR, PICKER, PACKER
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auditLogs     AuditLog[]

  @@map("users")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  address   String?
  isActive  Boolean  @default(true)
  parentId  String?
  parent    Warehouse?  @relation("FacilityHierarchy", fields: [parentId], references: [id])
  children  Warehouse[] @relation("FacilityHierarchy")
  createdAt DateTime @default(now())
  inventory  Inventory[]
  picklists  Picklist[]
  orders          Order[]
  cycleCounts     CycleCount[]
  purchaseOrders  PurchaseOrder[]
  transfersFrom   StockTransfer[] @relation("TransferFrom")
  transfersTo     StockTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

model SkuMaster {
  id          String   @id @default(uuid())
  tenantId    String
  skuCode     String   @unique
  name        String
  description String?
  category    String?
  hsnCode     String?
  weight      Decimal?
  dimensions  String?
  createdAt   DateTime @default(now())
  inventory      Inventory[]
  orderItems     OrderItem[]
  returns           Return[]
  cycleCountItems   CycleCountItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]

  @@map("sku_master")
}

model Inventory {
  id               String   @id @default(uuid())
  warehouseId      String
  skuId            String
  binLocation      String
  reorderPoint     Int      @default(0)
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  quantityAvailable Int    @default(0)
  lastUpdated      DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sku       SkuMaster @relation(fields: [skuId], references: [id])

  @@unique([warehouseId, skuId, binLocation])
  @@map("inventory")
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  warehouseId   String?
  orderNumber   String   @unique
  source        String?
  customerName  String
  shippingAddress String
  orderStatus   String   @default("PENDING")
  paymentStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[]
  tracking      CourierTracking?
  returns       Return[]
  rto           Rto?

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  unitPrice Decimal
  totalAmount Decimal
  status    String   @default("PENDING")

  order Order @relation(fields: [orderId], references: [id])
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@map("order_items")
}

model CourierTracking {
  id            String   @id @default(uuid())
  orderId       String   @unique
  courierName   String
  awbNumber     String   @unique
  shipmentStatus String
  shippedAt     DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("courier_tracking")
}

model Return {
  id        String   @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  reason    String?
  status    String   // REQUESTED, RECEIVED, QC_FAILED, QC_PASSED
  receivedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@map("returns")
}

model Rto {
  id          String   @id @default(uuid())
  orderId     String   @unique
  rtoReason   String?
  receivedDate DateTime @default(now())
  status      String   @default("PENDING_QC")

  order Order @relation(fields: [orderId], references: [id])

  @@map("rto")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Picklist {
  id         String   @id @default(uuid())
  warehouseId String
  status     String   @default("PENDING")
  pickerId   String?
  createdAt  DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("picklists")
}

model MarketplaceConfig {
  id          String   @id @default(uuid())
  tenantId    String
  marketplace String   // NYKAA, MYNTRA, TATACLIQ
  apiKey      String?
  apiSecret   String?
  sellerId    String?
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  syncStatus  String   @default("idle") // idle, syncing, error
  syncMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, marketplace])
  @@map("marketplace_configs")
}

model CycleCount {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  status      String   @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  startedBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  items     CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  id            String  @id @default(uuid())
  cycleCountId  String
  skuId         String
  binLocation   String?
  expectedQty   Int     @default(0)
  countedQty    Int?
  variance      Int?
  status        String  @default("PENDING") // PENDING, COUNTED, VERIFIED

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id])
  sku        SkuMaster  @relation(fields: [skuId], references: [id])

  @@unique([cycleCountId, skuId])
  @@map("cycle_count_items")
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  tenantId    String
  poNumber    String   @unique
  supplierId  String
  warehouseId String
  status      String   @default("DRAFT")
  orderDate   DateTime @default(now())
  expectedDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  skuId       String
  quantity    Int
  unitPrice   Decimal @default(0)
  receivedQty Int     @default(0)
  status      String  @default("PENDING")

  po  PurchaseOrder @relation(fields: [poId], references: [id])
  sku SkuMaster     @relation(fields: [skuId], references: [id])

  @@map("purchase_order_items")
}

model StockTransfer {
  id              String   @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          String   @default("DRAFT")
  notes           String?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id       String @id @default(uuid())
  transferId String
  skuId    String
  quantity Int
  status   String @default("PENDING")

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  sku      SkuMaster     @relation(fields: [skuId], references: [id])

  @@map("stock_transfer_items")
}

model MarketplaceOrderMapping {
  id              String   @id @default(uuid())
  tenantId        String
  marketplace     String   // NYKAA, MYNTRA, TATACLIQ
  marketplaceOrderId String @unique
  localOrderId    String   @unique
  orderData       Json?
  syncedAt        DateTime @default(now())

  @@map("marketplace_order_mappings")
}
