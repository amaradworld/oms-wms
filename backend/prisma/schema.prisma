generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  email         String   @unique
  passwordHash  String
  fullName      String?
  role          String   // SUPER_ADMIN, WAREHOUSE_MGR, PICKER, PACKER
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auditLogs     AuditLog[]

  @@map("users")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  address   String?
  isActive  Boolean  @default(true)
  parentId  String?
  parent    Warehouse?  @relation("FacilityHierarchy", fields: [parentId], references: [id])
  children  Warehouse[] @relation("FacilityHierarchy")
  createdAt DateTime @default(now())
  inventory  Inventory[]
  picklists  Picklist[]
  orders          Order[]
  cycleCounts     CycleCount[]
  purchaseOrders  PurchaseOrder[]
  transfersFrom   StockTransfer[] @relation("TransferFrom")
  transfersTo     StockTransfer[] @relation("TransferTo")
  pickWaves       PickWave[]
  users           User[]

  @@map("warehouses")
}

model SkuMaster {
  id          String   @id @default(uuid())
  tenantId    String
  skuCode     String   @unique
  name        String
  styleName   String?
  size        String?
  color       String?
  brand       String?
  category    String?
  material    String?
  gender      String?
  unitType    String?
  mrp         Decimal?
  description String?
  hsnCode     String?
  weight      Decimal?
  dimensions  String?
  createdAt   DateTime @default(now())
  inventory      Inventory[]
  orderItems     OrderItem[]
  returns           Return[]
  cycleCountItems   CycleCountItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]

  @@map("sku_master")
}

model Inventory {
  id               String   @id @default(uuid())
  warehouseId      String
  skuId            String
  binLocation      String
  reorderPoint     Int      @default(0)
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  quantityAvailable Int    @default(0)
  lastUpdated      DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sku       SkuMaster @relation(fields: [skuId], references: [id])

  @@unique([warehouseId, skuId, binLocation])
  @@map("inventory")
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  warehouseId   String?
  orderNumber   String   @unique
  source        String?
  customerName  String
  shippingAddress String
  orderStatus   String   @default("PENDING")
  paymentStatus String?
  slaDeadline   DateTime?
  ewayBillNumber String?
  irn           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[]
  tracking      CourierTracking?
  returns       Return[]
  rto           Rto?

  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  pickWaveOrders PickWaveOrder[]
  manifestShipments ManifestShipment[]
  ndrCases NdrCase[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  unitPrice Decimal
  totalAmount Decimal
  status    String   @default("PENDING")

  order Order @relation(fields: [orderId], references: [id])
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@map("order_items")
}

model CourierTracking {
  id            String   @id @default(uuid())
  orderId       String   @unique
  courierName   String
  awbNumber     String   @unique
  shipmentStatus String
  shippedAt     DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("courier_tracking")
}

model Return {
  id        String   @id @default(uuid())
  orderId   String
  skuId     String
  quantity  Int
  reason    String?
  status    String   // REQUESTED, RECEIVED, QC_FAILED, QC_PASSED
  receivedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@map("returns")
}

model Rto {
  id          String   @id @default(uuid())
  orderId     String   @unique
  rtoReason   String?
  receivedDate DateTime @default(now())
  status      String   @default("PENDING_QC")

  order Order @relation(fields: [orderId], references: [id])

  @@map("rto")
}

model NdrCase {
  id              String    @id @default(uuid())
  tenantId        String
  orderId         String
  courierName     String
  awbNumber       String?
  failureReason   String?
  status          String    @default("OPEN") // OPEN, REATTEMPT_SCHEDULED, RESOLVED, CLOSED
  reattemptDate   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("ndr_cases")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Picklist {
  id         String   @id @default(uuid())
  warehouseId String
  status     String   @default("PENDING")
  pickerId   String?
  createdAt  DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("picklists")
}

model MarketplaceConfig {
  id          String   @id @default(uuid())
  tenantId    String
  marketplace String   // NYKAA, MYNTRA, TATACLIQ
  apiKey      String?
  apiSecret   String?
  sellerId    String?
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  syncStatus  String   @default("idle") // idle, syncing, error
  syncMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, marketplace])
  @@map("marketplace_configs")
}

model CourierConfig {
  id             String   @id @default(uuid())
  tenantId       String
  courierName    String
  isActive       Boolean  @default(true)
  priority       Int      @default(10)
  pincodePrefixes String? // comma-separated, e.g. "10,11,12" or "*" for all
  minWeight      Decimal?
  maxWeight      Decimal?
  minOrderValue  Decimal?
  maxOrderValue  Decimal?
  speedTier      String   @default("standard") // express, standard, economy
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, courierName])
  @@map("courier_configs")
}

model CycleCount {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  status      String   @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  startedBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  items     CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  id            String  @id @default(uuid())
  cycleCountId  String
  skuId         String
  binLocation   String?
  expectedQty   Int     @default(0)
  countedQty    Int?
  variance      Int?
  status        String  @default("PENDING") // PENDING, COUNTED, VERIFIED

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id])
  sku        SkuMaster  @relation(fields: [skuId], references: [id])

  @@unique([cycleCountId, skuId])
  @@map("cycle_count_items")
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  tenantId    String
  poNumber    String   @unique
  supplierId  String
  warehouseId String
  status      String   @default("DRAFT")
  orderDate   DateTime @default(now())
  expectedDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  skuId       String
  quantity    Int
  unitPrice   Decimal @default(0)
  receivedQty Int     @default(0)
  status      String  @default("PENDING")

  po  PurchaseOrder @relation(fields: [poId], references: [id])
  sku SkuMaster     @relation(fields: [skuId], references: [id])

  @@map("purchase_order_items")
}

model StockTransfer {
  id              String   @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          String   @default("DRAFT")
  notes           String?
  createdBy       String?
  receivedBy      String?
  receivedAt      DateTime?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id          String @id @default(uuid())
  transferId  String
  skuId       String
  quantity    Int
  receivedQty Int    @default(0)
  status      String @default("PENDING")

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  sku      SkuMaster     @relation(fields: [skuId], references: [id])

  @@map("stock_transfer_items")
}

model PickWave {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  name        String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  orders    PickWaveOrder[]

  @@map("pick_waves")
}

model PickWaveOrder {
  id        String @id @default(uuid())
  waveId    String
  orderId   String
  status    String @default("PENDING")

  wave  PickWave @relation(fields: [waveId], references: [id])
  order Order    @relation(fields: [orderId], references: [id])

  @@unique([waveId, orderId])
  @@map("pick_wave_orders")
}

model Manifest {
  id              String             @id @default(uuid())
  tenantId        String
  manifestNumber  String             @unique
  courierName     String
  status          String             @default("OPEN") // OPEN, CLOSED
  totalShipments  Int                @default(0)
  closedAt        DateTime?
  createdAt       DateTime           @default(now())

  shipments ManifestShipment[]

  @@map("manifests")
}

model ManifestShipment {
  id          String   @id @default(uuid())
  manifestId  String
  orderId     String
  awbNumber   String
  courierName String

  manifest Manifest @relation(fields: [manifestId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([manifestId, orderId])
  @@map("manifest_shipments")
}

model MarketplaceOrderMapping {
  id              String   @id @default(uuid())
  tenantId        String
  marketplace     String   // NYKAA, MYNTRA, TATACLIQ
  marketplaceOrderId String @unique
  localOrderId    String   @unique
  orderData       Json?
  syncedAt        DateTime @default(now())

  @@map("marketplace_order_mappings")
}
