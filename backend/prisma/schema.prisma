generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String   @id
  name              String
  slug              String   @unique
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstin             String?
  logoUrl           String?
  isActive          Boolean  @default(true)
  menuAccess        Json?    // array of menu IDs this tenant can access, null = all menus
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  email        String     @unique
  passwordHash String
  fullName     String?
  role         String // PLATFORM_ADMIN, SUPER_ADMIN, WAREHOUSE_MGR, PICKER, PACKER
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  mfaSecret    String?
  mfaEnabled   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  gatepasses   Gatepass[]

  @@index([tenantId])
  @@map("users")
}

model Warehouse {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  address   String?
  isActive  Boolean     @default(true)
  parentId  String?
  parent    Warehouse?  @relation("FacilityHierarchy", fields: [parentId], references: [id])
  children  Warehouse[] @relation("FacilityHierarchy")
  createdAt DateTime    @default(now())

  // General Details
  code                   String?
  type                   String?  @default("Warehouse")
  displayName            String?
  partyName              String?
  websiteUrl             String?
  alternateCode          String?
  logoUrl                String?
  signatureUrl           String?
  posEnabled             Boolean? @default(false)
  processingCapacity     Int?
  allowMaxLimit          Boolean? @default(false)
  operationalType        String?
  associatedPosChannel   String?
  itemSealEnabled        Boolean? @default(false)
  priority               Int?     @default(1)
  contactPerson          String?
  contactEmail           String?
  contactPhone           String?
  openingTime            String?
  closingTime            String?
  b2cTaxAddressType      String?  @default("BillingAddress")
  channelImageProcessing Boolean? @default(false)
  autoPackageDimensions  Boolean? @default(false)

  // Accounting Details
  pan           String?
  tin           String?
  cst           String?
  serviceTax    String?
  gstin         String?
  upiAddress    String?
  bankName      String?
  accountNumber String?
  ifscCode      String?

  // Billing Address
  billingAddress1  String?
  billingAddress2  String?
  billingCity      String?
  billingPinCode   String?
  billingCountry   String? @default("India")
  billingState     String?
  billingPhone     String?
  billingLatitude  String?
  billingLongitude String?

  // Shipping Address
  shippingSameAsBilling Boolean? @default(true)
  shippingAddress1      String?
  shippingAddress2      String?
  shippingCity          String?
  shippingPinCode       String?
  shippingCountry       String?  @default("India")
  shippingState         String?
  shippingPhone         String?
  shippingLatitude      String?
  shippingLongitude     String?

  inventory      Inventory[]
  picklists      Picklist[]
  orders         Order[]
  cycleCounts    CycleCount[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  StockTransfer[]       @relation("TransferFrom")
  transfersTo    StockTransfer[]       @relation("TransferTo")
  pickWaves      PickWave[]
  users          User[]
  binLocations   BinLocation[]
  grns           Grn[]
  putawayTasks   PutawayTask[]
  sequences      FacilitySequence[]
  activityLogs   FacilityActivityLog[]

  @@map("warehouses")
}

model FacilitySequence {
  id                   String   @id @default(uuid())
  tenantId             String
  warehouseId          String
  sequenceName         String
  description          String?
  prefix               String?  @default("")
  currentValue         Int      @default(1)
  nextYearPrefix       String?  @default("")
  resetCounterNextYear Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, sequenceName])
  @@map("facility_sequences")
}

model FacilityActivityLog {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  userId      String?
  userEmail   String?
  action      String // FIELD_CHANGE, SEQUENCE_CHANGE, SETTINGS_CHANGE
  field       String?
  oldValue    String?
  newValue    String?
  description String?
  timestamp   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, timestamp])
  @@map("facility_activity_logs")
}

model SkuMaster {
  id                 String              @id @default(uuid())
  tenantId           String
  skuCode            String              @unique
  epcCode            String?             @unique
  name               String
  styleName          String?
  size               String?
  color              String?
  brand              String?
  category           String?
  material           String?
  gender             String?
  unitType           String?
  mrp                Decimal?
  description        String?
  hsnCode            String?
  weight             Decimal?
  dimensions         String?
  marketplaceSkus    Json?
  createdAt          DateTime            @default(now())
  inventory          Inventory[]
  orderItems         OrderItem[]
  returns            Return[]
  cycleCountItems    CycleCountItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]
  gatepassItems      GatepassItem[]
  grnItems           GrnItem[]
  putawayTasks       PutawayTask[]
  replenishmentTasks ReplenishmentTask[]
  asnItems           AsnItem[]

  @@index([tenantId])
  @@map("sku_master")
}

model Inventory {
  id                  String    @id @default(uuid())
  warehouseId         String
  skuId               String
  binLocation         String
  reorderPoint        Int       @default(0)
  quantityOnHand      Int       @default(0)
  quantityReserved    Int       @default(0)
  quantityAvailable   Int       @default(0)
  virtualInventory    Int       @default(0)
  notFound            Int       @default(0)
  type                String    @default("Good")
  batch               String?
  batchStatus         String?
  expiryDate          DateTime?
  expiryAlertSent     Boolean   @default(false)
  abcClass            String?   // A=high value, B=medium, C=low (for cycle count scheduling)
  status              String    @default("ACTIVE")
  inventoryAllocation Boolean   @default(true)
  inventorySync       Boolean   @default(true)
  skuMixing           Boolean   @default(true)
  shelfOnHold         Boolean   @default(false)
  lastUpdated         DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sku       SkuMaster @relation(fields: [skuId], references: [id])

  @@unique([warehouseId, skuId, binLocation])
  @@map("inventory")
}

model Order {
  id                    String    @id @default(uuid())
  tenantId              String
  warehouseId           String?
  orderNumber           String    @unique
  displayOrderCode      String?
  source                String?
  customerCode          String?
  customerName          String
  customerGstin         String?
  notificationEmail     String?
  notificationMobile    String?
  currency              String?   @default("INR")
  shippingAddress       String
  orderStatus           String    @default("PENDING")
  paymentStatus         String?
  paymentMode           String?
  slaDeadline           DateTime?
  slaStatus             String?   @default("ON_TRACK") // ON_TRACK, AT_RISK, BREACHED, MET
  slaBreachedAt         DateTime?
  channelProcessingTime DateTime?
  deliverMode           String?
  pdfAttachment         String?
  priority              String?
  orderAmount           Decimal?
  discountAmount        Decimal?  @default(0)
  giftWrapCharges       Decimal?  @default(0)
  shippingCharges       Decimal?  @default(0)
  ewayBillNumber        String?
  irn                   String?
  // Per-stage event timestamps (auto-populated on status change)
  firstResponseAt       DateTime?
  pickedAt              DateTime?
  packedAt              DateTime?
  manifestedAt          DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Billing Address
  billingName      String?
  billingAddress1  String?
  billingAddress2  String?
  billingCountry   String? @default("India")
  billingState     String?
  billingCity      String?
  billingDistrict  String?
  billingPinCode   String?
  billingPhone     String?
  billingLatitude  String?
  billingLongitude String?
  billingEmail     String?

  items    OrderItem[]
  tracking CourierTracking?
  returns  Return[]
  rto      Rto?
  invoice  Invoice?
  codSettlements CodSettlement[]

  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  pickWaveOrders    PickWaveOrder[]
  manifestShipments ManifestShipment[]
  ndrCases          NdrCase[]

  @@index([tenantId, orderStatus, slaDeadline])
  @@index([tenantId, source, deliveredAt])
  @@index([tenantId, slaStatus])
  @@map("orders")
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  skuId          String
  quantity       Int
  unitPrice      Decimal
  mrp            Decimal?  @default(0)
  discountAmount Decimal?  @default(0)
  totalAmount    Decimal
  status         String    @default("PENDING")
  scannedQty     Int       @default(0)
  batchNo        String?
  expiryDate     DateTime?

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

model CourierTracking {
  id                  String    @id @default(uuid())
  orderId             String    @unique
  courierName         String
  awbNumber           String    @unique
  shipmentStatus      String
  courierStatus       String?
  shippedAt           DateTime?
  estimatedDelivery   DateTime?
  deliveredAt         DateTime?
  picklistNumber      String?
  shipmentManifest    String?
  returnManifest      String?
  invoiceNumber       String?
  rtoFacility         String?
  shippingMethod      String?
  noOfBoxes           Int       @default(1)
  shippingPackageType String?
  shippingPackageCode String?
  packageDimensions   String?
  packageWeight       Decimal?
  zone                String?
  ewaybillValidTill   DateTime?
  ewaybillDate        DateTime?
  trackingUrl         String?

  order Order @relation(fields: [orderId], references: [id])

  @@map("courier_tracking")
}

model Return {
  id         String    @id @default(uuid())
  orderId    String
  skuId      String
  quantity   Int
  reason     String?
  status     String // REQUESTED, RECEIVED, QC_FAILED, QC_PASSED
  receivedAt DateTime?

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   SkuMaster @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@map("returns")
}

model Rto {
  id           String   @id @default(uuid())
  orderId      String   @unique
  rtoReason    String?
  receivedDate DateTime @default(now())
  status       String   @default("PENDING_QC")

  order Order @relation(fields: [orderId], references: [id])

  @@map("rto")
}

model NdrCase {
  id              String    @id @default(uuid())
  tenantId        String
  orderId         String
  courierName     String
  awbNumber       String?
  failureReason   String?
  status          String    @default("OPEN") // OPEN, REATTEMPT_SCHEDULED, RESOLVED, CLOSED
  reattemptDate   DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, firstResponseAt])
  @@map("ndr_cases")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId, timestamp])
  @@index([entityType, entityId, timestamp])
  @@index([tenantId, action, timestamp])
  @@map("audit_logs")
}

model Picklist {
  id          String    @id @default(uuid())
  warehouseId String
  status      String    @default("PENDING")
  pickerId    String?
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, status])
  @@map("picklists")
}

model MarketplaceConfig {
  id               String    @id @default(uuid())
  tenantId         String
  marketplace      String // NYKAA, MYNTRA, TATACLIQ
  apiKey           String?
  apiSecret        String?
  sellerId         String?
  isActive         Boolean   @default(true)
  safetyStockBuffer Int      @default(0) // units reserved per SKU for this channel
  lastSyncAt       DateTime?
  syncStatus       String    @default("idle") // idle, syncing, error
  syncMessage      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, marketplace])
  @@map("marketplace_configs")
}

model CourierConfig {
  id              String   @id @default(uuid())
  tenantId        String
  courierName     String
  isActive        Boolean  @default(true)
  priority        Int      @default(10)
  pincodePrefixes String? // comma-separated, e.g. "10,11,12" or "*" for all
  minWeight       Decimal?
  maxWeight       Decimal?
  minOrderValue   Decimal?
  maxOrderValue   Decimal?
  speedTier       String   @default("standard") // express, standard, economy
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, courierName])
  @@map("courier_configs")
}

model CycleCount {
  id          String    @id @default(uuid())
  tenantId    String
  warehouseId String
  status      String    @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  blindMode   Boolean   @default(false) // hide expected qty from counter
  abcFilter   String?   // comma-separated: "A,B" or null for all
  startedBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     CycleCountItem[]

  @@index([tenantId])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           String  @id @default(uuid())
  cycleCountId String
  skuId        String
  binLocation  String?
  expectedQty  Int     @default(0)
  countedQty   Int?
  variance     Int?
  status       String  @default("PENDING") // PENDING, COUNTED, VERIFIED

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  sku        SkuMaster  @relation(fields: [skuId], references: [id])

  @@unique([cycleCountId, skuId])
  @@map("cycle_count_items")
}

model Supplier {
  id             String          @id @default(uuid())
  tenantId       String
  code           String?
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  gstin          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String
  poNumber     String    @unique
  supplierId   String
  warehouseId  String
  status       String    @default("DRAFT")
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]
  grns      Grn[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model BinLocation {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  code        String
  zone        String?
  aisle       String?
  rack        String?
  shelf       String?
  maxCapacity Int      @default(0) // 0 = unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  putawayTasks PutawayTask[]

  @@unique([warehouseId, code])
  @@map("bin_locations")
}

model Grn {
  id              String    @id @default(uuid())
  tenantId        String
  poId            String
  asnId           String?
  warehouseId     String
  grnNumber       String    @unique
  vendorInvoiceNo String?
  status          String    @default("RECEIVING") // RECEIVING, QC_PENDING, QC_FAILED, APPROVED, REJECTED
  totalQty        Int       @default(0)
  acceptedQty     Int       @default(0)
  rejectedQty     Int       @default(0)
  notes           String?
  createdById     String?
  receivedAt      DateTime?
  qcStartedAt     DateTime?
  qcCompletedAt   DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  asn           Asn?          @relation(fields: [asnId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  items         GrnItem[]
  putawayTasks  PutawayTask[]

  @@index([tenantId])
  @@map("grns")
}

model GrnItem {
  id                String    @id @default(uuid())
  grnId             String
  poItemId          String
  skuId             String
  expectedQty       Int       @default(0)
  receivedQty       Int       @default(0)
  acceptedQty       Int       @default(0)
  rejectedQty       Int       @default(0)
  qcStatus          String    @default("PENDING") // PENDING, PASSED, FAILED
  qcNotes           String?
  batchNo           String?
  expiryDate        DateTime?
  manufacturingDate DateTime?
  receivedAt        DateTime?
  qcAt              DateTime?
  mrp               Decimal?  @default(0)

  grn    Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  sku    SkuMaster         @relation(fields: [skuId], references: [id])

  @@index([grnId])
  @@index([skuId])
  @@map("grn_items")
}

model PutawayTask {
  id           String    @id @default(uuid())
  tenantId     String
  warehouseId  String
  source       String // PUTAWAY_GRN_ITEM, PUTAWAY_CANCELLED_ITEM, PUTAWAY_GATEPASS_ITEM, PUTAWAY_SHELF_TRANSFER, PUTAWAY_PICKLIST_ITEM, PUTAWAY_RECEIVED_RETURNS
  sourceId     String? // ID of the source record (grnId, gatepassId, orderId, etc.)
  grnId        String?
  skuId        String
  expectedQty  Int       @default(0)
  completedQty Int       @default(0)
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  binId        String?
  createdById  String?
  assignedTo   String?
  assignedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  grn       Grn?         @relation(fields: [grnId], references: [id])
  sku       SkuMaster    @relation(fields: [skuId], references: [id])
  bin       BinLocation? @relation(fields: [binId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([warehouseId, status])
  @@map("putaway_tasks")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  skuId       String
  quantity    Int
  unitPrice   Decimal @default(0)
  receivedQty Int     @default(0)
  status      String  @default("PENDING")

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku      SkuMaster     @relation(fields: [skuId], references: [id])
  grnItems GrnItem[]

  @@index([poId])
  @@index([skuId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id              String    @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  status          String    @default("DRAFT")
  notes           String?
  createdBy       String?
  receivedBy      String?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]
  gatepasses    Gatepass[]

  @@index([tenantId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String @id @default(uuid())
  transferId  String
  skuId       String
  quantity    Int
  receivedQty Int    @default(0)
  status      String @default("PENDING")

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku      SkuMaster     @relation(fields: [skuId], references: [id])

  @@index([transferId])
  @@index([skuId])
  @@map("stock_transfer_items")
}

model PickWave {
  id          String    @id @default(uuid())
  tenantId    String
  warehouseId String
  name        String
  status      String    @default("PENDING")
  assignedTo  String?
  assignedAt  DateTime?
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  orders    PickWaveOrder[]

  @@index([tenantId, status])
  @@index([warehouseId, status])
  @@map("pick_waves")
}

model PickWaveOrder {
  id      String @id @default(uuid())
  waveId  String
  orderId String
  status  String @default("PENDING")

  wave  PickWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  order Order    @relation(fields: [orderId], references: [id])

  @@unique([waveId, orderId])
  @@map("pick_wave_orders")
}

model Manifest {
  id             String    @id @default(uuid())
  tenantId       String
  manifestNumber String    @unique
  courierName    String
  status         String    @default("OPEN") // OPEN, CLOSED
  totalShipments Int       @default(0)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  shipments ManifestShipment[]

  @@index([tenantId])
  @@map("manifests")
}

model ManifestShipment {
  id          String @id @default(uuid())
  manifestId  String
  orderId     String
  awbNumber   String
  courierName String

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([manifestId, orderId])
  @@map("manifest_shipments")
}

model MarketplaceOrderMapping {
  id                 String   @id @default(uuid())
  tenantId           String
  marketplace        String // NYKAA, MYNTRA, TATACLIQ
  marketplaceOrderId String   @unique
  localOrderId       String   @unique
  orderData          Json?
  syncedAt           DateTime @default(now())

  @@index([tenantId])
  @@map("marketplace_order_mappings")
}

model Gatepass {
  id              String    @id @default(uuid())
  tenantId        String
  code            String    @unique
  type            String // STOCK_TRANSFER, INCOMING, RETURN, MANUAL
  status          String    @default("PENDING") // PENDING, APPROVED, DISPATCHED, RECEIVED, CANCELLED
  quantity        Int       @default(0)
  toParty         String?
  expectedDate    DateTime?
  notes           String?
  stockTransferId String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stockTransfer StockTransfer? @relation(fields: [stockTransferId], references: [id])
  createdBy     User?          @relation(fields: [createdById], references: [id])
  items         GatepassItem[]

  @@map("gatepasses")
}

model GatepassItem {
  id            String   @id @default(uuid())
  gatepassId    String
  skuId         String
  quantity      Int
  scannedQty    Int      @default(0)
  status        String   @default("PENDING") // PENDING, PARTIAL, SCANNED
  inventoryType String   @default("GOOD_INVENTORY") // GOOD_INVENTORY, BAD_INVENTORY, QC_REJECTED
  shelfCode     String?
  unitPrice     Decimal?
  batchCode     String?
  forceAllocate Boolean  @default(false)

  gatepass Gatepass  @relation(fields: [gatepassId], references: [id], onDelete: Cascade)
  sku      SkuMaster @relation(fields: [skuId], references: [id])

  @@unique([gatepassId, skuId])
  @@index([gatepassId])
  @@map("gatepass_items")
}

model PlatformIntegration {
  id            String    @id @default(uuid())
  tenantId      String
  name          String // e.g. "Shopify", "Amazon", "Custom"
  platform      String // shopify, amazon, custom, flipkart, etc.
  apiBaseUrl    String?
  apiKey        String?
  apiSecret     String?
  accessToken   String?
  webhookUrl    String?
  syncInventory Boolean?  @default(false)
  syncOrders    Boolean?  @default(false)
  syncProducts  Boolean?  @default(false)
  isActive      Boolean   @default(true)
  lastSyncAt    DateTime?
  config        Json? // custom key-value pairs for flexible integrations
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, name])
  @@map("platform_integrations")
}

model ReplenishmentTask {
  id          String    @id @default(uuid())
  tenantId    String
  warehouseId String?
  skuId       String
  fromBin     String?
  toBin       String
  quantity    Int
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  assignedTo  String?
  assignedAt  DateTime?
  startedAt   DateTime?
  notes       String?
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sku SkuMaster @relation(fields: [skuId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([assignedTo, status])
  @@map("replenishment_tasks")
}

model Asn {
  id           String    @id @default(uuid())
  tenantId     String
  warehouseId  String?
  asnNumber    String    @unique
  supplierId   String?
  supplierName String?
  expectedDate DateTime?
  status       String    @default("PENDING") // PENDING, PARTIAL, RECEIVED, CANCELLED
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items AsnItem[]
  grns  Grn[]

  @@index([tenantId])
  @@map("asns")
}

model AsnItem {
  id          String    @id @default(uuid())
  asnId       String
  skuId       String
  expectedQty Int       @default(0)
  receivedQty Int       @default(0)
  batchNo     String?
  expiryDate  DateTime?

  asn Asn       @relation(fields: [asnId], references: [id], onDelete: Cascade)
  sku SkuMaster @relation(fields: [skuId], references: [id])

  @@index([asnId])
  @@index([skuId])
  @@map("asn_items")
}

model ProductivityLog {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String?
  userId      String?
  activity    String // PICKING, PACKING, PUTAWAY, GRN, CYCLE_COUNT
  entityType  String?
  entityId    String?
  quantity    Int      @default(0)
  durationMin Int? // time spent in minutes
  recordedAt  DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@index([userId, activity, recordedAt])
  @@index([warehouseId, activity, recordedAt])
  @@map("productivity_logs")
}

model Lead {
  id            String   @id @default(uuid())
  name          String
  email         String
  company       String?
  phone         String?
  monthlyOrders String? // "<500", "500-1k", "1k-5k", "5k-25k", "25k+"
  plan          String? // starter | pro | enterprise
  message       String?
  source        String? // marketing_site, demo_cta, plan_starter, etc.
  referrer      String?
  status        String   @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@map("leads")
}

model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  warehouseId   String
  orderId       String    @unique
  invoiceNumber String    @unique
  invoiceDate   DateTime  @default(now())
  totalAmount   Decimal
  taxAmount     Decimal   @default(0)
  cgstAmount    Decimal   @default(0)
  sgstAmount    Decimal   @default(0)
  igstAmount    Decimal   @default(0)
  status        String    @default("DRAFT") // DRAFT, ISSUED, CANCELLED
  irn           String?   // e-invoice IRN
  irnGeneratedAt DateTime?
  ewayBillNumber String?
  isCreditNote  Boolean   @default(false)
  creditNoteReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, invoiceNumber])
  @@index([tenantId, warehouseId])
  @@map("invoices")
}

model CodSettlement {
  id                String    @id @default(uuid())
  tenantId          String
  orderId           String
  marketplace       String?
  awbNumber         String?
  codAmount         Decimal
  settledAmount     Decimal?  
  settlementDate    DateTime?
  reconciliationStatus String @default("PENDING") // PENDING, MATCHED, DISCREPANCY, SETTLED
  discrepancyReason String?
  sellerAdjustment  Decimal?  @default(0)
  tds               Decimal?  @default(0)
  shippingCharge    Decimal?  @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, reconciliationStatus])
  @@index([tenantId, marketplace])
  @@map("cod_settlements")
}
