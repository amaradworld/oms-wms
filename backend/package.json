{
  "name": "backend",
  "version": "1.0.0",
  "description": "OMS-WMS Backend API",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate && tsc",
    "prestart": "node scripts/validate-env.js",
    "start": "node scripts/start.js",
    "dev": "nodemon src/index.ts",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:reset": "npx prisma migrate reset",
    "seed": "node src/seed.js",
    "backfill-sla": "npx ts-node src/scripts/backfill-sla.ts",
    "backfill-sla-history": "npx ts-node src/scripts/backfill-sla-history.ts",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/lib-storage": "^3.1054.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.2",
    "bwip-js": "^4.11.1",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "otplib": "^13.4.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
